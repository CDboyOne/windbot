<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Bot</AssemblyName>
    <RootNamespace>BotWrapper</RootNamespace>
    <ApplicationIcon>WindBot.ico</ApplicationIcon>
    <StartupObject>BotWrapper.BotWrapper</StartupObject>
    <Version>1.0.0</Version>
    <Authors>IceYGO</Authors>
    <Description>The Bot.exe wrapper of WindBot.</Description>
    <Copyright>Copyright © IceYGO 2015-2025</Copyright>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Update="bot.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="load-once.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
