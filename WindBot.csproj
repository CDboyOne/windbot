<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WindBot</AssemblyName>
    <RootNamespace>WindBot</RootNamespace>
    <ApplicationIcon>WindBot.ico</ApplicationIcon>
    <StartupObject>WindBot.Program</StartupObject>
    <Version>1.0.0</Version>
    <Authors>IceYGO</Authors>
    <Description>A C# bot for YGOPro.</Description>
    <Copyright>Copyright © IceYGO 2015-2025</Copyright>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BotWrapper/**" />
    <None Remove="BotWrapper/**" />
    <Content Remove="BotWrapper/**" />
    <EmbeddedResource Remove="BotWrapper/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="WindBot.dll.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Decks\*.ydk">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Dialogs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
